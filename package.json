{
  "name": "becket-ui",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.4.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:style": "node .cursor/skills/becket-guides/scripts/style-check.mjs",
    "test": "turbo run test",
    "pack:check": "node scripts/pack-check.mjs",
    "publish:check": "node scripts/check-publishable.mjs",
    "example:prepare": "node scripts/prepare-next-example.mjs",
    "example:dev": "pnpm example:prepare && npm --prefix apps/next-example run dev",
    "example:build": "pnpm example:prepare && npm --prefix apps/next-example run build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "workspaces": [
    "apps/docs",
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "prettier": "^3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
