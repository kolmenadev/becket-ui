{
  "name": "@becket-ui/mcp",
  "version": "0.5.1",
  "description": "MCP server that teaches coding agents to build UIs with Becket UI: components, props, examples, tokens and a usage review.",
  "type": "module",
  "license": "MIT",
  "author": "Kolmena de Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolmenadev/becket-ui.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/kolmenadev/becket-ui/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/kolmenadev/becket-ui/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "becket-ui",
    "design-system",
    "react",
    "ai"
  ],
  "bin": {
    "becket-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/build-data.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prepack": "node ../../scripts/assert-built.mjs dist/server.js dist/data/catalog.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@becket-ui/react": "workspace:*",
    "@becket-ui/tokens": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pngjs": "6.0.5",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
