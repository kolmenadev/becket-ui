{
  "name": "@becket-ui/react",
  "version": "0.7.0",
  "description": "Becket React component library",
  "type": "module",
  "license": "MIT",
  "author": "Kolmena de Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolmenadev/becket-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kolmenadev/becket-ui#readme",
  "bugs": {
    "url": "https://github.com/kolmenadev/becket-ui/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "panda-css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "guides"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly -p tsconfig.build.json && node scripts/add-js-extensions.mjs",
    "prepack": "node ../../scripts/assert-built.mjs dist/index.js dist/index.d.ts",
    "test": "vitest run",
    "test:visual": "vitest run -c vitest.visual.config.ts",
    "test:visual:update": "vitest run -c vitest.visual.config.ts --update",
    "storybook": "storybook dev -p 6006 -c ../../apps/docs/.storybook --project-root ../../apps/docs",
    "build-storybook": "storybook build -c ../../apps/docs/.storybook --project-root ../../apps/docs"
  },
  "peerDependencies": {
    "@becket-ui/tokens": "^0.7.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@becket-ui/a11y": "workspace:*",
    "@becket-ui/tokens": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pandacss/dev": "^2.3.0",
    "@puppeteer/browsers": "2.13.2",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-webdriverio": "5.0.0",
    "jsdom": "^26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "webdriverio": "^9.32.0"
  }
}
