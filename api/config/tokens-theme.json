{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": "../../packages/tokens",
  "mainEntryPointFilePath": "<projectFolder>/theme/index.d.ts",
  "newlineKind": "lf",
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.json",
    "skipLibCheck": true
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "tokens-theme.api.md",
    "reportFolder": "<projectFolder>/../../api",
    "reportTempFolder": "<projectFolder>/../../node_modules/.cache/api-extractor"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "warning"
      }
    },
    "tsdocMessageReporting": {
      "default": {
        "logLevel": "none"
      }
    }
  }
}
