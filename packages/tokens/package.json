{
  "name": "@becket-ui/tokens",
  "version": "0.1.0",
  "description": "Becket design tokens, Panda recipes, and prebuilt CSS",
  "type": "module",
  "license": "MIT",
  "author": "Kolmena de Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolmenadev/becket-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/kolmenadev/becket-ui#readme",
  "bugs": {
    "url": "https://github.com/kolmenadev/becket-ui/issues"
  },
  "keywords": [
    "design-system",
    "panda-css",
    "tokens",
    "css"
  ],
  "main": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styled-system",
    "theme/index.mjs",
    "theme/index.d.ts",
    "theme.example.css",
    "index.css",
    "index.mjs",
    "index.d.ts"
  ],
  "scripts": {
    "build": "panda codegen && panda cssgen && node scripts/bundle-css.mjs && tsup && node scripts/emit-preset-dts.mjs",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "test": "node --test theme/index.test.mjs"
  },
  "exports": {
    ".": {
      "import": "./index.mjs",
      "types": "./index.d.ts"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js",
      "default": "./dist/preset.js"
    },
    "./recipes": {
      "import": "./styled-system/recipes/index.mjs",
      "types": "./styled-system/recipes/index.d.ts"
    },
    "./patterns": {
      "import": "./styled-system/patterns/index.mjs",
      "types": "./styled-system/patterns/index.d.ts"
    },
    "./css": {
      "import": "./styled-system/css/index.mjs",
      "types": "./styled-system/css/index.d.ts"
    },
    "./tokens": {
      "import": "./styled-system/tokens/index.mjs",
      "types": "./styled-system/tokens/index.d.ts"
    },
    "./types": {
      "import": "./styled-system/types/index.mjs",
      "types": "./styled-system/types/index.d.ts"
    },
    "./jsx": {
      "import": "./styled-system/jsx/index.mjs",
      "types": "./styled-system/jsx/index.d.ts"
    },
    "./styles.css": "./styled-system/styles.css",
    "./index.css": "./index.css",
    "./theme.example.css": "./theme.example.css",
    "./theme": {
      "types": "./theme/index.d.ts",
      "storybook": "./theme/index.mjs",
      "module": "./theme/index.mjs",
      "browser": "./theme/index.mjs",
      "import": "./theme/index.mjs",
      "default": "./theme/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@pandacss/dev": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@pandacss/dev": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.1",
    "@typescript/typescript6": "^6.0.2",
    "rollup": "^4.34.8",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^8.5.1"
  }
}
