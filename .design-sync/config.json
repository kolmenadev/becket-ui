{
  "projectId": "d95bf78b-6853-4b84-b1a9-d3463cb01fc8",
  "pkg": "@becket-ui/react",
  "globalName": "Becket",
  "shape": "storybook",
  "storybookConfigDir": "apps/docs/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "pnpm -F \"@becket-ui/react...\" build && (cd apps/docs && STORYBOOK_BASE=./ npx storybook build -c .storybook -o ../../.design-sync/sb-reference)",
  "overrides": {
    "Switch": {
      "cardMode": "column"
    },
    "Dialog": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Drawer": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Menu": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Box": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md",
  "guidelinesGlob": [
    "guides/**/*.md"
  ]
}
